{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试后端 (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
            "cwd": "${workspaceFolder}",
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "调试 seq_stats 脚本",
            "type": "debugpy",
