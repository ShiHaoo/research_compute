            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "调试 find_orf 脚本",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.find_orf",
            "args": ["data/sample2.fasta"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "调试测试 (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "integratedTerminal"
        }
